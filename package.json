{
	"name": "@polyms/registry",
	"version": "1.0.0",
	"description": "Polyms Registry — update feed for Flutter and Tauri apps, and a proxy for the GitHub npm registry",
	"author": "Polyms",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/polyms/registry.git"
	},
	"homepage": "https://github.com/polyms/registry#readme",
	"bugs": {
		"url": "https://github.com/polyms/registry/issues"
	},
	"type": "module",
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write . && prettier -l --write .",
		"test": "biome lint . && vitest run",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,ts,mts,tsx,json,css,html}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"*.{md,yml,yaml}": ["prettier -l --write"]
	},
	"dependencies": {
		"async-retry": "1.3.3",
		"date-fns": "4.4.0",
		"hono": "4.13.13",
		"ms": "2.1.3",
		"semver": "7.8.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/async-retry": "1.4.9",
		"@types/ms": "2.1.0",
		"@types/node": "24.19.2",
		"@types/semver": "7.8.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "~3.9.10",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
