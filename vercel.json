{
	"headers": [
		{
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, immutable"
				}
			],
			"source": "/public/(.*)"
		}
	],
	"rewrites": [
		{
			"destination": "/public/favicon.ico",
			"source": "/favicon.ico"
		},
		{
			"destination": "/api",
			"source": "/(.*)"
		}
	]
}
