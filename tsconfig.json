{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
