{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"typeRoots": ["./node_modules/.pnpm/@types+node@24.19.2/node_modules/@types"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "vitest.config.ts"]
}
